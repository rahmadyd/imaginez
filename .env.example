# Supabase (server-side, for admin/template/share/analytics API routes)
SUPABASE_URL=
# Secret key (new 2026 format: sb_secret_...) - replaces legacy service_role
SUPABASE_SECRET_KEY=
# Publishable key (new 2026 format: sb_publishable_...) - untuk login admin via Supabase Auth
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_STORAGE_BUCKET=templates

# Admin auth
SESSION_SECRET=
# email admin yang boleh login (pisahkan dengan koma jika lebih dari satu)
ADMIN_EMAIL=
