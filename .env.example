# Supabase (server-side, for admin/template API routes)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=templates

# Admin auth
SESSION_SECRET=
# admin email (dev fallback: admin@imaginez.local)
ADMIN_EMAIL=
# sha256 hex of admin password (dev fallback: "admin" when unset in non-production)
ADMIN_PASSWORD_HASH=
