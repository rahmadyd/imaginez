# Supabase (server-side, for admin/template/share/analytics API routes)
SUPABASE_URL=
# Secret key (new 2026 format: sb_secret_...) - replaces legacy service_role
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=templates

# Admin auth
SESSION_SECRET=
# admin email (dev fallback: admin@imaginez.local)
ADMIN_EMAIL=
# sha256 hex of admin password (dev fallback: "admin" when unset in non-production)
ADMIN_PASSWORD_HASH=